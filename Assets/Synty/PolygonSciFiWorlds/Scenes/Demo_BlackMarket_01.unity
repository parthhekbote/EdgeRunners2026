  m_Script: {fileID: 11500000, guid: 724e58138b27477b898904446c0a5812, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SyntyCombined.BlackMarket.BlackMarketNPC
  characterName: Deck Tech Silas
  roleType: 3
  roleBadgeTitle: SPACESUIT TECH // PAD 01
  badgeColor: {r: 0.95, g: 0.6, b: 0.15, a: 1}
  portraitIcon: {fileID: 0}
  canTalk: 1
  isStoryObjectiveNPC: 0
  unlockObjectiveText: 'MISSION UPDATED: Head down the gantry stairs to the Collector''s armored pod with the alien skull'
  leadId: 
  leadTitle: 
  leadInsight: 
  dialogueEntries:
  - dialogueText: 'Alita: "Hey. Where do I find the Collector around here?"'
    choiceOptionText: 
    speakerMood: Neutral
  - dialogueText: "\"Looking for Voss? Head down the gantry stairs past the market stalls. Look for the armored pod with that big alien skull over the door. Can't miss it\u2014two heavy alien bruisers are standing guard outside.\""
    choiceOptionText: 
    speakerMood: Helpful
  - dialogueText: 'Alita: "Understood. Thanks."'
    choiceOptionText: 
    speakerMood: Neutral
  - dialogueText: '"Watch your back in there. Nobody walks out of Voss''s den without losing something."'
    choiceOptionText: 
    speakerMood: Cautious
  returnDialogueEntries: []
  waitingDialogueText: "\"Like I said\u2014down the gantry stairs. Look for the pod with the skull and the two alien bruisers.\""
  interactionRange: 5
  promptOffset: {x: 0, y: 2.1, z: 0}
  interactionSFX: {fileID: 0}
  voiceChatterSFX: []
  animator: {fileID: 1416527386}
  defaultIdleID: 7
  playAmbientFidgets: 1
  fidgetIntervalMin: 6
  fidgetIntervalMax: 12
