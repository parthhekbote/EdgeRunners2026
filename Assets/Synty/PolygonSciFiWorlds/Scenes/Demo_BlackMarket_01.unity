  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SyntyCombined.BlackMarket.BlackMarketNPC
  characterName: Vex 'Trigger' Malakor
  roleType: 1
  roleBadgeTitle: WEAPONS // ARMS BROKER
  badgeColor: {r: 0.95, g: 0.25, b: 0.25, a: 1}
  portraitIcon: {fileID: 0}
  canTalk: 0
  isStoryObjectiveNPC: 0
  unlockObjectiveText: 
  leadId: 
  leadTitle: 
  leadInsight: 
  dialogueEntries:
  - dialogueText: Looking for firepower, hunter? Out here on Sector 4, your blade is only as sharp as your reflexes.
    choiceOptionText: 
    speakerMood: Neutral
  - dialogueText: I see you carry genuine Damascus steel. Magnificent craftsmanship. If you're heading toward the Martian warzone, make sure you keep your plasma edge charged.
    choiceOptionText: 
    speakerMood: Neutral
  returnDialogueEntries: []
  waitingDialogueText: Get that Data Core from the refinery terminal across the gantry first, Alita. No core, no coordinates.
