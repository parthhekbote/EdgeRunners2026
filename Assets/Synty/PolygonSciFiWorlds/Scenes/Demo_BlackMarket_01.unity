  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SyntyCombined.BlackMarket.BlackMarketNPC
  characterName: Balthazar 'Neon' Cruz
  roleType: 4
  roleBadgeTitle: BAR // NEON SPIRITS
  badgeColor: {r: 0.95, g: 0.15, b: 0.85, a: 1}
  portraitIcon: {fileID: 0}
  canTalk: 0
  isStoryObjectiveNPC: 0
  unlockObjectiveText: 
  leadId: 
  leadTitle: 
  leadInsight: 
  dialogueEntries:
  - dialogueText: What'll it be, warrior? Liquid nitrogen gin, distilled Martian agave, or pure battery-grade synthetic rum?
    choiceOptionText: 
    speakerMood: Neutral
  - dialogueText: The landing pad out there has been on high alert ever since your ship touched down. Word is Omni-Corp has eyes on every gantry.
    choiceOptionText: 
    speakerMood: Neutral
  returnDialogueEntries: []
  waitingDialogueText: Get that Data Core from the refinery terminal across the gantry first, Alita. No core, no coordinates.
  interactionRange: 3.2
  promptOffset: {x: 0, y: 2.1, z: 0}
  interactionSFX: {fileID: 0}
  voiceChatterSFX: []
  animator: {fileID: 1296194954}
  defaultIdleID: 26
  playAmbientFidgets: 1
  fidgetIntervalMin: 6
  fidgetIntervalMax: 12
