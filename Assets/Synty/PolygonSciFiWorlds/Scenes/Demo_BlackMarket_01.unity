  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SyntyCombined.BlackMarket.BlackMarketNPC
  characterName: Magnus Holt
  roleType: 3
  roleBadgeTitle: TECH // MECH ENGINEER
  badgeColor: {r: 0.98, g: 0.45, b: 0.05, a: 1}
  portraitIcon: {fileID: 0}
  canTalk: 0
  isStoryObjectiveNPC: 0
  unlockObjectiveText: 
  leadId: 
  leadTitle: 
  leadInsight: 
  dialogueEntries:
  - dialogueText: I tune the hydraulic servomotors for the heavy cargo loaders. If you're heading to Mars, prepare for Titan-class security mechs.
    choiceOptionText: 
    speakerMood: Neutral
  - dialogueText: Their armor is reinforced across the torso, but the knee actuators and neck joints are vulnerable to high-frequency plasma blades.
    choiceOptionText: 
    speakerMood: Neutral
  returnDialogueEntries: []
  waitingDialogueText: Get that Data Core from the refinery terminal across the gantry first, Alita. No core, no coordinates.
  interactionRange: 3.2
  promptOffset: {x: 0, y: 2.1, z: 0}
  interactionSFX: {fileID: 0}
  voiceChatterSFX: []
  animator: {fileID: 500958942}
  defaultIdleID: 7
  playAmbientFidgets: 1
  fidgetIntervalMin: 6
  fidgetIntervalMax: 12
