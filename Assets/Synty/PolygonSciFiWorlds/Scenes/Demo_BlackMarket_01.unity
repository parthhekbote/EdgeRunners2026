  portraitIcon: {fileID: 0}
  canTalk: 0
  isStoryObjectiveNPC: 0
  unlockObjectiveText: 
  leadId: 
  leadTitle: 
  leadInsight: 
  dialogueEntries:
  - dialogueText: Reflex enhancers, adrenaline surges, overclocked neural synapses. When the shooting starts, you'll experience time at half speed.
    choiceOptionText: 
    speakerMood: Neutral
  - dialogueText: Corporate bounties don't scare me. The station enforcers know who keeps their med-bays stocked.
    choiceOptionText: 
    speakerMood: Neutral
  returnDialogueEntries: []
  waitingDialogueText: Get that Data Core from the refinery terminal across the gantry first, Alita. No core, no coordinates.
  interactionRange: 3.2
  promptOffset: {x: 0, y: 2.1, z: 0}
  interactionSFX: {fileID: 0}
