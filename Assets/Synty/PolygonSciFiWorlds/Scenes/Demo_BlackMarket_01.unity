  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SyntyCombined.BlackMarket.BlackMarketNPC
  characterName: Torg 'Anvil' Karr
  roleType: 1
  roleBadgeTitle: ARMOR // SHIELDING SMITH
  badgeColor: {r: 0.98, g: 0.65, b: 0.15, a: 1}
  portraitIcon: {fileID: 0}
  canTalk: 0
  isStoryObjectiveNPC: 0
  unlockObjectiveText: 
  leadId: 
  leadTitle: 
  leadInsight: 
  dialogueEntries:
  - dialogueText: Kinetic plating, ballistic ceramic weaves, and ionized reactive mesh. When an Omni-Corp gunship opens up with 30mm tungsten rounds, you'll thank me.
    choiceOptionText: 
    speakerMood: Neutral
  - dialogueText: That Damascus blade of yours... I could reinforce the hilt crossguard with titanium-carbide if you find spare scrap.
    choiceOptionText: 
    speakerMood: Neutral
  returnDialogueEntries: []
  waitingDialogueText: Get that Data Core from the refinery terminal across the gantry first, Alita. No core, no coordinates.
  interactionRange: 3.2
  promptOffset: {x: 0, y: 2.1, z: 0}
  interactionSFX: {fileID: 0}
  voiceChatterSFX: []
  animator: {fileID: 81208315}
  defaultIdleID: 7
  playAmbientFidgets: 1
  fidgetIntervalMin: 6
  fidgetIntervalMax: 12
