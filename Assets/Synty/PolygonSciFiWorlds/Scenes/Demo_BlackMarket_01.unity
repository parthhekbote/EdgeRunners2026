  leadInsight: 
  dialogueEntries:
  - dialogueText: Welcome aboard the Red Horizon outfitting barge. We supply long-range hyperspace fuel, plasma thruster nozzles, and heat shielding.
    choiceOptionText: 
    speakerMood: Neutral
  - dialogueText: Your starship's flight systems look tuned for high-velocity combat. Be ready when you jump to Martian orbit.
    choiceOptionText: 
    speakerMood: Neutral
  returnDialogueEntries: []
  waitingDialogueText: Get that Data Core from the refinery terminal across the gantry first, Alita. No core, no coordinates.
  interactionRange: 3.2
  promptOffset: {x: 0, y: 2.1, z: 0}
