  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SyntyCombined.BlackMarket.BlackMarketNPC
  characterName: Madame Zara
  roleType: 0
  roleBadgeTitle: BAZAAR // MARKET OVERSEER
  badgeColor: {r: 0.75, g: 0.25, b: 0.95, a: 1}
  portraitIcon: {fileID: 0}
  canTalk: 0
  isStoryObjectiveNPC: 0
  unlockObjectiveText: 
  leadId: 
  leadTitle: 
  leadInsight: 
  dialogueEntries:
  - dialogueText: Welcome to Sector 4's grand bazaar. Everything here has a price, and everyone has a past they're trying to outrun.
    choiceOptionText: 
    speakerMood: Neutral
  - dialogueText: You're looking for The Collector? He keeps his office inside the skull-marked relic pod down the southwest corridor. Don't touch his trophies unless you want to lose an arm.
    choiceOptionText: 
    speakerMood: Neutral
  returnDialogueEntries: []
  waitingDialogueText: Get that Data Core from the refinery terminal across the gantry first, Alita. No core, no coordinates.
  interactionRange: 3.2
  promptOffset: {x: 0, y: 2.1, z: 0}
  interactionSFX: {fileID: 0}
  voiceChatterSFX: []
  animator: {fileID: 654817670}
  defaultIdleID: 3
  playAmbientFidgets: 1
  fidgetIntervalMin: 6
  fidgetIntervalMax: 12
