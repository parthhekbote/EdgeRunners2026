  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SyntyCombined.BlackMarket.BlackMarketNPC
  characterName: Silas Vance
  roleType: 3
  roleBadgeTitle: TECH // HARDWARE SALVAGE
  badgeColor: {r: 0.9, g: 0.55, b: 0.1, a: 1}
  portraitIcon: {fileID: 0}
  canTalk: 0
  isStoryObjectiveNPC: 0
  unlockObjectiveText: 
  leadId: 
  leadTitle: 
  leadInsight: 
  dialogueEntries:
  - dialogueText: High-output solenoid relays, magnetic induction coils, atmospheric seals... if it was bolted to a ship, my salvagers pried it loose.
    choiceOptionText: 
    speakerMood: Neutral
  - dialogueText: Watch your step on the lower gantry. The magnetic locks are leaking current.
    choiceOptionText: 
    speakerMood: Neutral
  returnDialogueEntries: []
  waitingDialogueText: Get that Data Core from the refinery terminal across the gantry first, Alita. No core, no coordinates.
  interactionRange: 3.2
  promptOffset: {x: 0, y: 2.1, z: 0}
  interactionSFX: {fileID: 0}
  voiceChatterSFX: []
  animator: {fileID: 503728669}
  defaultIdleID: 5
  playAmbientFidgets: 1
  fidgetIntervalMin: 6
  fidgetIntervalMax: 12
