  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SyntyCombined.BlackMarket.BlackMarketNPC
  characterName: Jaxom 'Sparks' Cole
  roleType: 3
  roleBadgeTitle: PARTS // PROPULSION BROKER
  badgeColor: {r: 0.2, g: 0.7, b: 1, a: 1}
  portraitIcon: {fileID: 0}
  canTalk: 0
  isStoryObjectiveNPC: 0
  unlockObjectiveText: 
  leadId: 
  leadTitle: 
  leadInsight: 
  dialogueEntries:
  - dialogueText: Need hyperdrive injectors or sub-light cooling baffles? I pull the best military surplus from the scrap barges.
    choiceOptionText: 
    speakerMood: Neutral
  - dialogueText: Keep an eye on your heat sinks when you pull high-G turns in the asteroid ring. Vacuum doesn't dissipate thermal build-up easily.
    choiceOptionText: 
    speakerMood: Neutral
  returnDialogueEntries: []
  waitingDialogueText: Get that Data Core from the refinery terminal across the gantry first, Alita. No core, no coordinates.
  interactionRange: 3.2
  promptOffset: {x: 0, y: 2.1, z: 0}
  interactionSFX: {fileID: 0}
  voiceChatterSFX: []
  animator: {fileID: 1987076643}
  defaultIdleID: 4
  playAmbientFidgets: 1
  fidgetIntervalMin: 6
  fidgetIntervalMax: 12
