  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SyntyCombined.BlackMarket.BlackMarketNPC
  characterName: Jett Chromium
  roleType: 7
  roleBadgeTitle: MERC // HITMAN
  badgeColor: {r: 0.95, g: 0.25, b: 0.25, a: 1}
  portraitIcon: {fileID: 0}
  canTalk: 0
  isStoryObjectiveNPC: 0
  unlockObjectiveText: 
  leadId: 
  leadTitle: 
  leadInsight: 
  dialogueEntries:
  - dialogueText: Keep your blade close, girl. Half the patrons in this cantina have Omni-Corp bounties on their neuro-chips.
    choiceOptionText: 
    speakerMood: Neutral
  - dialogueText: If you're looking for work, talk to the Fixer in the trophy den. He pays in real credits, not scrip.
    choiceOptionText: 
    speakerMood: Neutral
  returnDialogueEntries: []
  waitingDialogueText: Get that Data Core from the refinery terminal across the gantry first, Alita. No core, no coordinates.
  interactionRange: 4.5
  promptOffset: {x: 0, y: 2.1, z: 0}
  interactionSFX: {fileID: 0}
