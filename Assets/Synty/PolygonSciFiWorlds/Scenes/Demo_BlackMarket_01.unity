  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SyntyCombined.BlackMarket.BlackMarketNPC
  characterName: Dr. Aris Thorne
  roleType: 2
  roleBadgeTitle: MED // CHIEF RIPPERDOC
  badgeColor: {r: 0.2, g: 0.85, b: 0.5, a: 1}
  portraitIcon: {fileID: 0}
  canTalk: 0
  isStoryObjectiveNPC: 0
  unlockObjectiveText: 
  leadId: 
  leadTitle: 
  leadInsight: 
  dialogueEntries:
  - dialogueText: Fascinating bio-mechanical chassis... Martian Berserker design, isn't it? Pre-war URM nanotech.
    choiceOptionText: 
    speakerMood: Neutral
  - dialogueText: Your neural circuits are running on emergency reserves without your central core. Retrieve it from Cydonia, and your body will unleash its true kinetic overdrive.
    choiceOptionText: 
    speakerMood: Neutral
  returnDialogueEntries: []
  waitingDialogueText: Get that Data Core from the refinery terminal across the gantry first, Alita. No core, no coordinates.
  interactionRange: 3.2
  promptOffset: {x: 0, y: 2.1, z: 0}
  interactionSFX: {fileID: 0}
  voiceChatterSFX: []
  animator: {fileID: 887568053}
  defaultIdleID: 1
  playAmbientFidgets: 1
  fidgetIntervalMin: 6
  fidgetIntervalMax: 12
