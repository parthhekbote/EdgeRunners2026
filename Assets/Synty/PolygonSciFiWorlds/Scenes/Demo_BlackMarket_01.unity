--- !u!114 &469901008
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 469901006}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 724e58138b27477b898904446c0a5812, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SyntyCombined.BlackMarket.BlackMarketNPC
  characterName: The Collector (Kaelen Voss)
  roleType: 0
  roleBadgeTitle: THE COLLECTOR // ALIEN RELIC OVERLORD
  badgeColor: {r: 0.95, g: 0.75, b: 0.15, a: 1}
  portraitIcon: {fileID: 0}
  canTalk: 1
  isStoryObjectiveNPC: 1
  unlockObjectiveText: 'MISSION ACTIVE: Head to Western Flight Deck, Board Starship & Retrieve 4 Core Matrices [0/4]'
  leadId: 
  leadTitle: 
  leadInsight: 
  dialogueEntries:
  - dialogueText: 'Alita: "You''re Voss. I hear you have the jump coordinates to Mars."'
    choiceOptionText: 
    speakerMood: Neutral
  - dialogueText: 'Voss: "Word travels fast. Yeah, I''ve got the nav-data locked in my terminal. But nothing on Drift is free, hunter."'
    choiceOptionText: 
    speakerMood: Shrewd
  - dialogueText: 'Alita: "What''s your price?"'
    choiceOptionText: 
    speakerMood: Neutral
  - dialogueText: 'Voss: "Omni-Corp raided my vault and scattered four high-energy Antimatter Cores into the orbital space debris outside our broken dome. Take the SS-04 Nightshade Striker on the Western Flight Deck, use the ventral tractor beam [T] to retrieve all 4 cores floating in space, and bring them back directly to me. Do that, and the Mars coordinates are yours."'
    choiceOptionText: 
    speakerMood: Business
  - dialogueText: 'Alita: "4 cores floating in space. Consider it done."'
    choiceOptionText: 
    speakerMood: Confident
  returnDialogueEntries:
  - dialogueText: 'Alita: "I brought all 4 antimatter cores from orbit, Voss. Every single matrix accounted for. Now hand over the Mars jump coordinates like you promised."'
    choiceOptionText: 
    speakerMood: Neutral
  - dialogueText: 'Voss: "All four intact URM cores... Transferring them into my vault right now. You really came through, Alita. The Syndicate owes you a great debt."'
    choiceOptionText: 
    speakerMood: Sinister
  - dialogueText: 'Voss: "Which is why it''s a real shame I have to break our deal. See, Omni-Corp offered 100,000 credits for your intact Berserker chassis. And I don''t leave money on the table."'
    choiceOptionText: 
    speakerMood: Sinister
  - dialogueText: 'Voss: "Did you honestly think I was going to let you fly off to Mars? You''re worth far more to me dead! Syndicate Enforcers, lock down the concourse! Roll out the Heavy Siege Tank from the garage and blast her to scrap metal!"'
    choiceOptionText: 
    speakerMood: Aggressive
  - dialogueText: 'Alita: "You cowardly traitor, Voss! You used me to retrieve your cores and sold me out to Omni-Corp! I''m taking these coordinates, and when I''m done with your tank, I''m coming back for you!"'
    choiceOptionText: 
    speakerMood: Defiant
  waitingDialogueText: Retrieve all 4 Antimatter Cores from the orbital space debris outside the dome first, Alita. No cores, no Mars coordinates.
  interactionRange: 5.5
  promptOffset: {x: 0, y: 2.1, z: 0}
  interactionSFX: {fileID: 0}
  voiceChatterSFX: []
  animator: {fileID: 469901007}
  defaultIdleID: 3
  playAmbientFidgets: 1
  fidgetIntervalMin: 6
  fidgetIntervalMax: 12
